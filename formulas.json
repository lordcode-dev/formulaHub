[
  {"id":1,"name":"Quadratic Formula","category":"Algebra","formula":"x = (-b ± √(b²-4ac))/(2a)","description":"Solve ax² + bx + c = 0","inputs":["a","b","c"],"calc":"(-b + Math.sqrt(b*b-4*a*c))/(2*a)"},
  {"id":2,"name":"Slope of a Line","category":"Algebra","formula":"m = (y₂ - y₁)/(x₂ - x₁)","description":"Slope between two points","inputs":["x1","y1","x2","y2"],"calc":"(y2 - y1)/(x2 - x1)"},
  {"id":3,"name":"Area of Circle","category":"Geometry","formula":"A = πr²","description":"Area of a circle","inputs":["r"],"calc":"Math.PI*r*r"},
  {"id":4,"name":"Circumference of Circle","category":"Geometry","formula":"C = 2πr","description":"Circumference of a circle","inputs":["r"],"calc":"2*Math.PI*r"},
  {"id":5,"name":"Pythagoras Theorem","category":"Trigonometry","formula":"c² = a² + b²","description":"Relation in right triangle","inputs":["a","b"],"calc":"Math.sqrt(a*a + b*b)"},
  {"id":6,"name":"Sine Rule","category":"Trigonometry","formula":"a/sinA = b/sinB = c/sinC","description":"Relates sides and angles in triangle","inputs":["a","A","b","B","c","C"],"calc":"a/Math.sin(A) === b/Math.sin(B) && b/Math.sin(B) === c/Math.sin(C)"},
  {"id":7,"name":"Derivative of xⁿ","category":"Calculus","formula":"d/dx(xⁿ) = n*xⁿ⁻¹","description":"Derivative of a power function","inputs":["n","x"],"calc":"n*Math.pow(x,n-1)"},
  {"id":8,"name":"Integral of xⁿ","category":"Calculus","formula":"∫xⁿ dx = xⁿ⁺¹/(n+1) + C","description":"Indefinite integral of a power function","inputs":["n","x"],"calc":"Math.pow(x,n+1)/(n+1)"},
  {"id":9,"name":"Mean","category":"Statistics","formula":"μ = Σx / n","description":"Average of values","inputs":["x1","x2","x3","x4","x5"],"calc":"(x1+x2+x3+x4+x5)/5"},
  {"id":10,"name":"Variance","category":"Statistics","formula":"σ² = Σ(x - μ)² / n","description":"Variance of values","inputs":["x1","x2","x3","x4","x5","mean"],"calc":"((x1-mean)**2+(x2-mean)**2+(x3-mean)**2+(x4-mean)**2+(x5-mean)**2)/5"},
  {"id":11,"name":"Newton's 2nd Law","category":"Physics","formula":"F = m * a","description":"Force = mass × acceleration","inputs":["m","a"],"calc":"m*a"},
  {"id":12,"name":"Kinetic Energy","category":"Physics","formula":"KE = 1/2 * m * v²","description":"Kinetic energy of a moving body","inputs":["m","v"],"calc":"0.5*m*v*v"},
  {"id":13,"name":"Gravitational Potential Energy","category":"Physics","formula":"U = m * g * h","description":"Potential energy due to height","inputs":["m","g","h"],"calc":"m*g*h"},
  {"id":14,"name":"Ohm's Law","category":"Physics","formula":"V = I * R","description":"Voltage = current × resistance","inputs":["I","R"],"calc":"I*R"},
  {"id":15,"name":"Circumference of Ellipse","category":"Geometry","formula":"C ≈ π [ 3(a+b) - √((3a+b)(a+3b)) ]","description":"Approximation of ellipse perimeter","inputs":["a","b"],"calc":"Math.PI*(3*(a+b)-Math.sqrt((3*a+b)*(a+3*b)))"}
  {"id":16,"name":"Linear Equation","category":"Algebra","formula":"x = (b - c) / a","description":"Solve ax + c = b","inputs":["a","b","c"],"calc":"(b-c)/a"},
  {"id":17,"name":"Quadratic Discriminant","category":"Algebra","formula":"Δ = b² - 4ac","description":"Determines the nature of roots of a quadratic equation","inputs":["a","b","c"],"calc":"b*b-4*a*c"},
  {"id":18,"name":"Distance Between Two Points","category":"Algebra","formula":"d = √((x₂-x₁)² + (y₂-y₁)²)","description":"Distance between two points in a coordinate plane","inputs":["x1","y1","x2","y2"],"calc":"Math.sqrt((x2-x1)**2+(y2-y1)**2)"},
  {"id":19,"name":"Midpoint Formula","category":"Algebra","formula":"M = ((x₁+x₂)/2, (y₁+y₂)/2)","description":"Find the midpoint between two points","inputs":["x1","y1","x2","y2"],"calc":"[(x1+x2)/2,(y1+y2)/2]"},
  {"id":20,"name":"Point-Slope Form","category":"Algebra","formula":"y-y₁ = m(x-x₁)","description":"Equation of a line from a point and slope","inputs":["m","x1","y1","x"],"calc":"y1+m*(x-x1)"},

  {"id":21,"name":"Area of Triangle","category":"Geometry","formula":"A = 1/2 bh","description":"Area of a triangle","inputs":["b","h"],"calc":"0.5*b*h"},
  {"id":22,"name":"Area of Rectangle","category":"Geometry","formula":"A = lw","description":"Area of a rectangle","inputs":["l","w"],"calc":"l*w"},
  {"id":23,"name":"Area of Trapezoid","category":"Geometry","formula":"A = 1/2(a+b)h","description":"Area of a trapezoid","inputs":["a","b","h"],"calc":"0.5*(a+b)*h"},
  {"id":24,"name":"Area of Parallelogram","category":"Geometry","formula":"A = bh","description":"Area of a parallelogram","inputs":["b","h"],"calc":"b*h"},
  {"id":25,"name":"Volume of Cylinder","category":"Geometry","formula":"V = πr²h","description":"Volume of a cylinder","inputs":["r","h"],"calc":"Math.PI*r*r*h"},
  {"id":26,"name":"Volume of Sphere","category":"Geometry","formula":"V = 4/3πr³","description":"Volume of a sphere","inputs":["r"],"calc":"(4/3)*Math.PI*r**3"},
  {"id":27,"name":"Surface Area of Sphere","category":"Geometry","formula":"A = 4πr²","description":"Surface area of a sphere","inputs":["r"],"calc":"4*Math.PI*r*r"},
  {"id":28,"name":"Volume of Cone","category":"Geometry","formula":"V = 1/3πr²h","description":"Volume of a cone","inputs":["r","h"],"calc":"(1/3)*Math.PI*r*r*h"},

  {"id":29,"name":"Cosine Rule","category":"Trigonometry","formula":"c² = a² + b² - 2ab cos(C)","description":"Find a side or angle in a non-right triangle","inputs":["a","b","C"],"calc":"Math.sqrt(a*a+b*b-2*a*b*Math.cos(C*Math.PI/180))"},
  {"id":30,"name":"Tangent Ratio","category":"Trigonometry","formula":"tan(θ) = opposite/adjacent","description":"Relates opposite and adjacent sides in a right triangle","inputs":["opposite","adjacent"],"calc":"Math.atan(opposite/adjacent)*180/Math.PI"},
  {"id":31,"name":"Sine Ratio","category":"Trigonometry","formula":"sin(θ) = opposite/hypotenuse","description":"Find an angle using sine","inputs":["opposite","hypotenuse"],"calc":"Math.asin(opposite/hypotenuse)*180/Math.PI"},
  {"id":32,"name":"Cosine Ratio","category":"Trigonometry","formula":"cos(θ) = adjacent/hypotenuse","description":"Find an angle using cosine","inputs":["adjacent","hypotenuse"],"calc":"Math.acos(adjacent/hypotenuse)*180/Math.PI"},
  {"id":33,"name":"Triangle Area Using Sine","category":"Trigonometry","formula":"A = 1/2 ab sin(C)","description":"Area of a triangle using two sides and included angle","inputs":["a","b","C"],"calc":"0.5*a*b*Math.sin(C*Math.PI/180)"},

  {"id":34,"name":"Product Rule","category":"Calculus","formula":"(fg)' = f'g + fg'","description":"Derivative of a product of two functions","inputs":["fPrime","g","f","gPrime"],"calc":"fPrime*g+f*gPrime"},
  {"id":35,"name":"Quotient Rule","category":"Calculus","formula":"(f/g)' = (f'g - fg')/g²","description":"Derivative of a quotient","inputs":["fPrime","g","f","gPrime"],"calc":"(fPrime*g-f*gPrime)/(g*g)"},
  {"id":36,"name":"Chain Rule","category":"Calculus","formula":"d/dx f(g(x)) = f'(g(x))g'(x)","description":"Derivative of a composite function","inputs":["outerDerivative","innerDerivative"],"calc":"outerDerivative*innerDerivative"},
  {"id":37,"name":"Derivative of sin(x)","category":"Calculus","formula":"d/dx sin(x) = cos(x)","description":"Derivative of sine","inputs":["x"],"calc":"Math.cos(x)"},
  {"id":38,"name":"Derivative of cos(x)","category":"Calculus","formula":"d/dx cos(x) = -sin(x)","description":"Derivative of cosine","inputs":["x"],"calc":"-Math.sin(x)"},
  {"id":39,"name":"Derivative of eˣ","category":"Calculus","formula":"d/dx eˣ = eˣ","description":"Derivative of exponential function","inputs":["x"],"calc":"Math.exp(x)"},
  {"id":40,"name":"Definite Integral of xⁿ","category":"Calculus","formula":"∫ₐᵇ xⁿ dx = (bⁿ⁺¹-aⁿ⁺¹)/(n+1)","description":"Evaluate a power integral over an interval","inputs":["n","a","b"],"calc":"(Math.pow(b,n+1)-Math.pow(a,n+1))/(n+1)"},

  {"id":41,"name":"Standard Deviation","category":"Statistics","formula":"σ = √(Σ(x-μ)²/n)","description":"Measures spread of a population","inputs":["variance"],"calc":"Math.sqrt(variance)"},
  {"id":42,"name":"Z-Score","category":"Statistics","formula":"z = (x-μ)/σ","description":"Number of standard deviations a value is from the mean","inputs":["x","mean","std"],"calc":"(x-mean)/std"},
  {"id":43,"name":"Percentage Change","category":"Statistics","formula":"% Change = ((New-Old)/Old) × 100","description":"Percentage increase or decrease","inputs":["oldValue","newValue"],"calc":"((newValue-oldValue)/oldValue)*100"},
  {"id":44,"name":"Probability of an Event","category":"Statistics","formula":"P(A) = favorable outcomes / total outcomes","description":"Basic probability of an event","inputs":["favorable","total"],"calc":"favorable/total"},
  {"id":45,"name":"Combination","category":"Statistics","formula":"C(n,r) = n!/(r!(n-r)!)","description":"Number of ways to choose r objects from n","inputs":["n","r"],"calc":"factorial(n)/(factorial(r)*factorial(n-r))"},
  {"id":46,"name":"Permutation","category":"Statistics","formula":"P(n,r) = n!/(n-r)!","description":"Number of ordered arrangements","inputs":["n","r"],"calc":"factorial(n)/factorial(n-r)"},

  {"id":47,"name":"Work","category":"Physics","formula":"W = Fd cos(θ)","description":"Work done by a force","inputs":["F","d","theta"],"calc":"F*d*Math.cos(theta*Math.PI/180)"},
  {"id":48,"name":"Power","category":"Physics","formula":"P = W/t","description":"Rate of doing work","inputs":["W","t"],"calc":"W/t"},
  {"id":49,"name":"Momentum","category":"Physics","formula":"p = mv","description":"Linear momentum","inputs":["m","v"],"calc":"m*v"},
  {"id":50,"name":"Impulse","category":"Physics","formula":"J = FΔt","description":"Change in momentum caused by a force","inputs":["F","dt"],"calc":"F*dt"},
  {"id":51,"name":"Gravitational Force","category":"Physics","formula":"F = Gm₁m₂/r²","description":"Newton's law of universal gravitation","inputs":["G","m1","m2","r"],"calc":"G*m1*m2/(r*r)"},
  {"id":52,"name":"Coulomb's Law","category":"Physics","formula":"F = kq₁q₂/r²","description":"Electric force between two charges","inputs":["k","q1","q2","r"],"calc":"k*q1*q2/(r*r)"},
  {"id":53,"name":"Electrical Power","category":"Physics","formula":"P = VI","description":"Electrical power","inputs":["V","I"],"calc":"V*I"},
  {"id":54,"name":"Electrical Energy","category":"Physics","formula":"E = Pt","description":"Electrical energy consumed","inputs":["P","t"],"calc":"P*t"},
  {"id":55,"name":"Wave Speed","category":"Physics","formula":"v = fλ","description":"Relationship between wave speed, frequency, and wavelength","inputs":["f","lambda"],"calc":"f*lambda"},

  {"id":56,"name":"Molarity","category":"Chemistry","formula":"M = moles/volume","description":"Concentration of a solution in mol/L","inputs":["moles","volume"],"calc":"moles/volume"},
  {"id":57,"name":"Moles from Mass","category":"Chemistry","formula":"n = m/M","description":"Calculate amount of substance from mass and molar mass","inputs":["mass","molarMass"],"calc":"mass/molarMass"},
  {"id":58,"name":"Ideal Gas Law","category":"Chemistry","formula":"PV = nRT","description":"Relates pressure, volume, amount, and temperature of an ideal gas","inputs":["P","V","n","R","T"],"calc":"n*R*T/V"},
  {"id":59,"name":"Density","category":"Chemistry","formula":"ρ = m/V","description":"Mass per unit volume","inputs":["mass","volume"],"calc":"mass/volume"},
  {"id":60,"name":"pH","category":"Chemistry","formula":"pH = -log₁₀[H⁺]","description":"Measures acidity of a solution","inputs":["H"],"calc":"-Math.log10(H)"},
  {"id":61,"name":"pOH","category":"Chemistry","formula":"pOH = -log₁₀[OH⁻]","description":"Measures hydroxide concentration","inputs":["OH"],"calc":"-Math.log10(OH)"},
  {"id":62,"name":"Percent Yield","category":"Chemistry","formula":"% Yield = (Actual/Theoretical) × 100","description":"Efficiency of a chemical reaction","inputs":["actual","theoretical"],"calc":"(actual/theoretical)*100"},

  {"id":63,"name":"Simple Interest","category":"Finance","formula":"I = Prt","description":"Interest earned on a principal amount","inputs":["P","r","t"],"calc":"P*r*t"},
  {"id":64,"name":"Compound Interest","category":"Finance","formula":"A = P(1+r/n)^(nt)","description":"Future value with compound interest","inputs":["P","r","n","t"],"calc":"P*Math.pow(1+r/n,n*t)"},
  {"id":65,"name":"Continuous Compound Interest","category":"Finance","formula":"A = Pe^(rt)","description":"Future value with continuous compounding","inputs":["P","r","t"],"calc":"P*Math.exp(r*t)"},
  {"id":66,"name":"Present Value","category":"Finance","formula":"PV = FV/(1+r)^t","description":"Current value of a future amount","inputs":["FV","r","t"],"calc":"FV/Math.pow(1+r,t)"},
  {"id":67,"name":"Profit Margin","category":"Finance","formula":"Margin = (Profit/Revenue) × 100","description":"Profit as a percentage of revenue","inputs":["profit","revenue"],"calc":"(profit/revenue)*100"},
  {"id":68,"name":"Return on Investment","category":"Finance","formula":"ROI = ((Gain-Cost)/Cost) × 100","description":"Percentage return on an investment","inputs":["gain","cost"],"calc":"((gain-cost)/cost)*100"},

  {"id":69,"name":"GDP Growth Rate","category":"Economics","formula":"Growth = ((GDP₂-GDP₁)/GDP₁) × 100","description":"Percentage change in gross domestic product","inputs":["GDP1","GDP2"],"calc":"((GDP2-GDP1)/GDP1)*100"},
  {"id":70,"name":"Price Elasticity of Demand","category":"Economics","formula":"PED = %ΔQd/%ΔP","description":"Measures responsiveness of quantity demanded to price","inputs":["percentQuantityChange","percentPriceChange"],"calc":"percentQuantityChange/percentPriceChange"},
  {"id":71,"name":"Average Cost","category":"Economics","formula":"AC = TC/Q","description":"Total cost per unit of output","inputs":["totalCost","quantity"],"calc":"totalCost/quantity"},
  {"id":72,"name":"Marginal Cost","category":"Economics","formula":"MC = ΔTC/ΔQ","description":"Change in total cost from producing additional output","inputs":["changeCost","changeQuantity"],"calc":"changeCost/changeQuantity"},
  {"id":73,"name":"Break-Even Point","category":"Business","formula":"Q = Fixed Costs/(Price-Variable Cost)","description":"Units required to break even","inputs":["fixedCost","price","variableCost"],"calc":"fixedCost/(price-variableCost)"},

  {"id":74,"name":"Binary to Decimal","category":"Computer Science","formula":"Decimal = Σ(bit × 2^position)","description":"Convert a binary number to decimal","inputs":["binary"],"calc":"parseInt(binary,2)"},
  {"id":75,"name":"Decimal to Binary","category":"Computer Science","formula":"Binary = decimal.toString(2)","description":"Convert a decimal number to binary","inputs":["decimal"],"calc":"decimal.toString(2)"},
  {"id":76,"name":"Speed","category":"Engineering","formula":"v = d/t","description":"Distance traveled per unit time","inputs":["d","t"],"calc":"d/t"},
  {"id":77,"name":"Acceleration","category":"Engineering","formula":"a = Δv/Δt","description":"Change in velocity over time","inputs":["deltaV","deltaT"],"calc":"deltaV/deltaT"},
  {"id":78,"name":"Stress","category":"Engineering","formula":"σ = F/A","description":"Force per unit area","inputs":["F","A"],"calc":"F/A"},
  {"id":79,"name":"Strain","category":"Engineering","formula":"ε = ΔL/L₀","description":"Relative deformation of a material","inputs":["deltaL","L0"],"calc":"deltaL/L0"},
  {"id":80,"name":"Ohmic Resistance","category":"Engineering","formula":"R = V/I","description":"Resistance from voltage and current","inputs":["V","I"],"calc":"V/I"},

  {"id":81,"name":"BMI","category":"Health & Biology","formula":"BMI = mass/height²","description":"Body mass index using kg and meters","inputs":["mass","height"],"calc":"mass/(height*height)"},
  {"id":82,"name":"Hardy-Weinberg Allele Frequency","category":"Biology","formula":"p + q = 1","description":"Relationship between two allele frequencies","inputs":["p"],"calc":"1-p"},
  {"id":83,"name":"Hardy-Weinberg Homozygous Frequency","category":"Biology","formula":"p² + 2pq + q² = 1","description":"Expected genotype frequencies in a population","inputs":["p","q"],"calc":"p*p+2*p*q+q*q"},
  {"id":84,"name":"Exponential Growth","category":"Biology","formula":"N = N₀e^(rt)","description":"Continuous population growth model","inputs":["N0","r","t"],"calc":"N0*Math.exp(r*t)"},
  {"id":85,"name":"Half-Life","category":"Biology","formula":"t₁/₂ = ln(2)/k","description":"Time required for a quantity to decrease by half","inputs":["k"],"calc":"Math.log(2)/k"},

  {"id":86,"name":"Matrix Determinant 2×2","category":"Linear Algebra","formula":"det(A) = ad-bc","description":"Determinant of a 2×2 matrix","inputs":["a","b","c","d"],"calc":"a*d-b*c"},
  {"id":87,"name":"Dot Product","category":"Linear Algebra","formula":"a·b = Σaᵢbᵢ","description":"Dot product of two vectors","inputs":["a1","a2","a3","b1","b2","b3"],"calc":"a1*b1+a2*b2+a3*b3"},
  {"id":88,"name":"Vector Magnitude","category":"Linear Algebra","formula":"|v| = √(x²+y²+z²)","description":"Magnitude of a three-dimensional vector","inputs":["x","y","z"],"calc":"Math.sqrt(x*x+y*y+z*z)"},

  {"id":89,"name":"Logarithm Change of Base","category":"Mathematics","formula":"log_b(x) = ln(x)/ln(b)","description":"Convert a logarithm to another base","inputs":["x","b"],"calc":"Math.log(x)/Math.log(b)"},
  {"id":90,"name":"Arithmetic Sequence","category":"Sequences","formula":"aₙ = a₁ + (n-1)d","description":"Find the nth term of an arithmetic sequence","inputs":["a1","n","d"],"calc":"a1+(n-1)*d"},
  {"id":91,"name":"Arithmetic Series","category":"Sequences","formula":"Sₙ = n/2[2a₁+(n-1)d]","description":"Sum of the first n terms of an arithmetic sequence","inputs":["n","a1","d"],"calc":"(n/2)*(2*a1+(n-1)*d)"},
  {"id":92,"name":"Geometric Sequence","category":"Sequences","formula":"aₙ = a₁r^(n-1)","description":"Find the nth term of a geometric sequence","inputs":["a1","r","n"],"calc":"a1*Math.pow(r,n-1)"},
  {"id":93,"name":"Geometric Series","category":"Sequences","formula":"Sₙ = a₁(1-rⁿ)/(1-r)","description":"Sum of a finite geometric sequence","inputs":["a1","r","n"],"calc":"a1*(1-Math.pow(r,n))/(1-r)"},

  {"id":94,"name":"Bayes' Theorem","category":"Probability","formula":"P(A|B) = P(B|A)P(A)/P(B)","description":"Conditional probability using Bayes' theorem","inputs":["P_B_given_A","P_A","P_B"],"calc":"(P_B_given_A*P_A)/P_B"},
  {"id":95,"name":"Expected Value","category":"Probability","formula":"E(X) = ΣxP(x)","description":"Long-run average value of a random variable","inputs":["x1","p1","x2","p2","x3","p3"],"calc":"x1*p1+x2*p2+x3*p3"},
  {"id":96,"name":"Standard Error","category":"Statistics","formula":"SE = σ/√n","description":"Standard error of the mean","inputs":["std","n"],"calc":"std/Math.sqrt(n)"},
  {"id":97,"name":"Confidence Interval","category":"Statistics","formula":"CI = x̄ ± z(σ/√n)","description":"Approximate confidence interval for a population mean","inputs":["mean","z","std","n"],"calc":"[mean-z*(std/Math.sqrt(n)),mean+z*(std/Math.sqrt(n))]"},
  {"id":98,"name":"Linear Regression Slope","category":"Statistics","formula":"b₁ = Σ(x-x̄)(y-ȳ)/Σ(x-x̄)²","description":"Slope of a simple linear regression line","inputs":["covariance","varianceX"],"calc":"covariance/varianceX"},
  {"id":99,"name":"RMS","category":"Mathematics","formula":"RMS = √(Σx²/n)","description":"Root mean square of values","inputs":["sumSquares","n"],"calc":"Math.sqrt(sumSquares/n)"},
  {"id":100,"name":"Percentage","category":"Mathematics","formula":"Percentage = (part/whole) × 100","description":"Calculate a percentage","inputs":["part","whole"],"calc":"(part/whole)*100"}

]

